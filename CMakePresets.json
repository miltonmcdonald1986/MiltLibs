{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_CXX_SCAN_FOR_MODULES": "OFF" }
    },
    { "name": "debug", "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    {
      "name": "msvc",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" },
      "architecture": { "value": "x64", "strategy": "external" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "clang",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "gcc",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "emscripten",
      "hidden": true,
      "inherits": "base",
      "description": "Builds runners for the browser. Needs EMSDK set: run emsdk_env first. Serve the output with emrun.",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": { "MILTLIBS_BUILD_TESTS": "OFF" }
    },
    { "name": "msvc-debug", "displayName": "MSVC Debug", "inherits": ["msvc", "debug"] },
    { "name": "msvc-release", "displayName": "MSVC Release", "inherits": ["msvc", "release"] },
    { "name": "clang-debug", "displayName": "Clang Debug", "inherits": ["clang", "debug"] },
    { "name": "clang-release", "displayName": "Clang Release", "inherits": ["clang", "release"] },
    {
      "name": "clang-tidy",
      "displayName": "Clang Debug + clang-tidy",
      "description": "clang-debug, with clang-tidy run on each MiltLibs source as it compiles. CI runs run-clang-tidy instead.",
      "inherits": "clang-debug",
      "cacheVariables": { "CMAKE_CXX_CLANG_TIDY": "clang-tidy" }
    },
    { "name": "gcc-debug", "displayName": "GCC Debug", "inherits": ["gcc", "debug"] },
    { "name": "gcc-release", "displayName": "GCC Release", "inherits": ["gcc", "release"] },
    { "name": "web-debug", "displayName": "Web Debug", "inherits": ["emscripten", "debug"] },
    { "name": "web-release", "displayName": "Web Release", "inherits": ["emscripten", "release"] },
    {
      "name": "docs",
      "displayName": "Docs",
      "description": "Builds only the Doxygen API reference, into build/docs/html. Needs Doxygen on PATH.",
      "inherits": "base",
      "cacheVariables": {
        "MILTLIBS_BUILD_DOCS": "ON",
        "MILTLIBS_BUILD_TESTS": "OFF",
        "MILTLIBS_BUILD_RUNNERS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc-debug" },
    { "name": "msvc-release", "configurePreset": "msvc-release" },
    { "name": "clang-debug", "configurePreset": "clang-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "clang-tidy", "configurePreset": "clang-tidy" },
    { "name": "gcc-debug", "configurePreset": "gcc-debug" },
    { "name": "gcc-release", "configurePreset": "gcc-release" },
    { "name": "web-debug", "configurePreset": "web-debug" },
    { "name": "web-release", "configurePreset": "web-release" },
    { "name": "docs", "configurePreset": "docs", "targets": ["milt_docs"] }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 120 }
    },
    { "name": "msvc-debug", "inherits": "base", "configurePreset": "msvc-debug" },
    { "name": "msvc-release", "inherits": "base", "configurePreset": "msvc-release" },
    { "name": "clang-debug", "inherits": "base", "configurePreset": "clang-debug" },
    { "name": "clang-release", "inherits": "base", "configurePreset": "clang-release" },
    { "name": "gcc-debug", "inherits": "base", "configurePreset": "gcc-debug" },
    { "name": "gcc-release", "inherits": "base", "configurePreset": "gcc-release" }
  ],
  "workflowPresets": [
    {
      "name": "msvc-debug",
      "steps": [
        { "type": "configure", "name": "msvc-debug" },
        { "type": "build", "name": "msvc-debug" },
        { "type": "test", "name": "msvc-debug" }
      ]
    },
    {
      "name": "msvc-release",
      "steps": [
        { "type": "configure", "name": "msvc-release" },
        { "type": "build", "name": "msvc-release" },
        { "type": "test", "name": "msvc-release" }
      ]
    },
    {
      "name": "clang-debug",
      "steps": [
        { "type": "configure", "name": "clang-debug" },
        { "type": "build", "name": "clang-debug" },
        { "type": "test", "name": "clang-debug" }
      ]
    },
    {
      "name": "clang-release",
      "steps": [
        { "type": "configure", "name": "clang-release" },
        { "type": "build", "name": "clang-release" },
        { "type": "test", "name": "clang-release" }
      ]
    },
    {
      "name": "gcc-debug",
      "steps": [
        { "type": "configure", "name": "gcc-debug" },
        { "type": "build", "name": "gcc-debug" },
        { "type": "test", "name": "gcc-debug" }
      ]
    },
    {
      "name": "gcc-release",
      "steps": [
        { "type": "configure", "name": "gcc-release" },
        { "type": "build", "name": "gcc-release" },
        { "type": "test", "name": "gcc-release" }
      ]
    },
    {
      "name": "web-release",
      "steps": [
        { "type": "configure", "name": "web-release" },
        { "type": "build", "name": "web-release" }
      ]
    }
  ]
}

---
# Checks disabled or narrowed below are explained in the commits that changed them.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  misc-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-math-missing-parentheses,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-type-union-access
WarningsAsErrors: '*'
CheckOptions:
  # glm's public headers forward to glm/ext and glm/detail without IWYU pragmas, so
  # include-cleaner would ask for internal headers and call the public ones unused.
  # Both separators, as in HeaderFilterRegex below.
  misc-include-cleaner.IgnoreHeaders: 'glm[/\\].*'
  # Plain structs with every member public are fine; mixed classes are still checked.
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  # Only the l suffix is easy to misread (as 1); lowercase f and u are fine.
  readability-uppercase-literal-suffix.NewSuffixes: 'L;LL;LU;LLU'
# Every MiltLibs header (library, runner and test), but none from _deps. Paths on Windows
# can mix separators, so both are accepted.
HeaderFilterRegex: '[/\\]libs[/\\]'
ExcludeHeaderFilterRegex: '[/\\]_deps[/\\]'
...
